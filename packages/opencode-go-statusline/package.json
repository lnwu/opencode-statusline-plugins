{
  "name": "opencode-go-statusline",
  "version": "1.0.3",
  "description": "OpenCode TUI plugin: display OpenCode Go subscription quota (rolling 5h / weekly / monthly) in the footer statusline. V2-native, zero-config, no cookies.",
  "keywords": [
    "opencode",
    "opencode-go",
    "opencode-plugin",
    "quota",
    "statusline",
    "usage"
  ],
  "homepage": "https://github.com/lnwu/opencode-statusline-plugins/tree/main/packages/opencode-go-statusline#readme",
  "bugs": {
    "url": "https://github.com/lnwu/opencode-statusline-plugins/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lnwu/opencode-statusline-plugins.git",
    "directory": "packages/opencode-go-statusline"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./rpc": "./dist/rpc.js",
    "./tui": "./dist/tui.js"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "record:demo": "bun run build && bun scripts/record-demo.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "bun run build",
    "test": "bun test --conditions=browser test/footer.test.ts test/usage.test.ts",
    "test:e2e": "bun run build && bun test test/e2e",
    "test:pack": "bun test test/pack.test.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@opencode/plugin": ">2.0.0"
  },
  "devDependencies": {
    "@opentui/core": "^0.5.11",
    "@opentui/solid": "^0.5.11",
    "bun-types": "^1.4.2",
    "core": "*",
    "solid-js": "^1.9.15",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0"
  }
}
