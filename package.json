{
  "name": "opencode-statusline-plugins",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter './packages/*' --if-present build",
    "typecheck": "bun run --filter './packages/*' --if-present typecheck",
    "changelog:check": "bun scripts/release-notes.ts --check",
    "test": "bun run --filter './packages/*' --if-present test",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "^0.70.0"
  }
}
